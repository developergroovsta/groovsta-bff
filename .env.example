# Groovsta local environment example
# Copy this to `.env` and replace the production-sensitive values.

# Database
GROOVSTA_DATABASE_URL=jdbc:postgresql://localhost:5432/groovsta
GROOVSTA_DATABASE_USERNAME=groovsta
GROOVSTA_DATABASE_PASSWORD=groovsta
GROOVSTA_DATABASE_DRIVER=org.postgresql.Driver
SERVER_PORT=8080

# Authentication and verification
IDENTITY_VERIFICATION_PEPPER=change-me
GROOVSTA_GOOGLE_AUTH_ENABLED=true
GROOVSTA_GOOGLE_REGISTRATION_TTL=10m

# Email delivery (Gmail SMTP; use a Gmail App Password, not the account password)
GROOVSTA_EMAIL_ENABLED=true
GROOVSTA_EMAIL_FROM=groovstadeveloper@gmail.com
GROOVSTA_EMAIL_REPLY_TO=groovstadeveloper@gmail.com
GROOVSTA_EMAIL_USERNAME=groovstadeveloper@gmail.com
GROOVSTA_EMAIL_APP_PASSWORD=replace-with-gmail-app-password
GROOVSTA_EMAIL_SMTP_HOST=smtp.gmail.com
GROOVSTA_EMAIL_SMTP_PORT=587

# Firebase
GROOVSTA_FIREBASE_ENABLED=true
GROOVSTA_FIREBASE_PROJECT_ID=your-firebase-project-id
GROOVSTA_FIREBASE_CREDENTIALS_PATH=/Users/you/.config/groovsta/firebase-service-account.json
GROOVSTA_FIREBASE_CREDENTIALS_BASE64=
GROOVSTA_PUSH_ENABLED=true
GROOVSTA_PUSH_POLL_INTERVAL=2000
GROOVSTA_PUSH_BATCH_SIZE=100
GROOVSTA_PUSH_LEASE_DURATION=30s
GROOVSTA_PUSH_MAX_ATTEMPTS=6
GROOVSTA_PUSH_INITIAL_RETRY_DELAY=5s
GROOVSTA_PUSH_MAX_RETRY_DELAY=10m
GROOVSTA_PUSH_NOTIFICATION_TTL=7d
GROOVSTA_PUSH_INCLUDE_SENSITIVE_PREVIEWS=false

# Storage
GROOVSTA_S3_BUCKET=your-bucket-name
AWS_REGION=ap-south-1
GROOVSTA_S3_ENDPOINT=
GROOVSTA_S3_PATH_STYLE_ACCESS=false
GROOVSTA_S3_IMAGE_PREFIX=images
GROOVSTA_S3_VIDEO_PREFIX=videos

# Content
GROOVSTA_MAX_REEL_BYTES=524288000
GROOVSTA_MAX_POST_IMAGE_BYTES=20971520
GROOVSTA_MAX_STORY_IMAGE_BYTES=20971520
GROOVSTA_MAX_STORY_VIDEO_BYTES=524288000
GROOVSTA_TRANSCODE_CALLBACK_SECRET=change-me

# Locations / Ola Maps
# Production: enable only after setting a real Ola Maps API key.
GROOVSTA_OLA_MAPS_ENABLED=false
GROOVSTA_OLA_MAPS_BASE_URL=https://api.olamaps.io
GROOVSTA_OLA_MAPS_API_KEY=
# Required when the Ola API key has Allowed Domains restrictions.
GROOVSTA_OLA_MAPS_ORIGIN=https://your-api-domain.example.com
GROOVSTA_LOCATION_LANGUAGE=en
GROOVSTA_LOCATION_SEARCH_MIN_LENGTH=3
GROOVSTA_LOCATION_SEARCH_CACHE_TTL=7d
GROOVSTA_LOCATION_REVERSE_CACHE_TTL=30d
GROOVSTA_LOCATION_SEARCH_RADIUS_METERS=50000
GROOVSTA_LOCATION_SEARCH_LIMIT=20
GROOVSTA_LOCATION_PROVIDER_RATE_LIMIT_PER_MINUTE=30

# Rewards
GROOVSTA_REWARDS_SIGNUP_COINS=5
GROOVSTA_REWARDS_REEL_SCROLL_UNIT=100
GROOVSTA_REWARDS_REEL_SCROLL_COINS=1
GROOVSTA_REWARDS_REEL_UPLOAD_UNIT=5
GROOVSTA_REWARDS_REEL_UPLOAD_COINS=1
GROOVSTA_REWARDS_REEL_UPLOAD_CLAIM_BUFFER=7d
GROOVSTA_REWARDS_LIKE_CLAIM_BUFFER=7d
GROOVSTA_REWARDS_FOLLOWER_CLAIM_BUFFER=7d

# Trust/admin
GROOVSTA_MODERATION_ADMIN_KEY=change-me

# Calls
GROOVSTA_CALL_MAX_PARTICIPANTS=8
GROOVSTA_CALL_RING_TIMEOUT=30s
GROOVSTA_CALL_HEARTBEAT_TIMEOUT=90s
GROOVSTA_CALL_CLEANUP_INTERVAL=10000
GROOVSTA_CALL_STUN_URLS=stun:stun.l.google.com:19302
TURN_EXTERNAL_IP=127.0.0.1
TURN_USERNAME=groovsta
TURN_PASSWORD=change-me
GROOVSTA_CALL_TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
GROOVSTA_CALL_TURN_USERNAME=groovsta
GROOVSTA_CALL_TURN_CREDENTIAL=change-me

# Chat media
GROOVSTA_CHAT_MAX_ATTACHMENTS=10
GROOVSTA_CHAT_MAX_IMAGE_BYTES=20971520
GROOVSTA_CHAT_MAX_VIDEO_BYTES=524288000
GROOVSTA_CHAT_MAX_BATCH_BYTES=524288000
GROOVSTA_CHAT_MAX_DIMENSION_PIXELS=12000
GROOVSTA_CHAT_MAX_VIDEO_DURATION=15m
GROOVSTA_CHAT_ABANDONED_UPLOAD_RETENTION=24h
GROOVSTA_CHAT_UPLOAD_CLEANUP_INTERVAL=3600000
